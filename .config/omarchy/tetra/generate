def neovim_lua(variant, c, r):
    """A lazy.nvim spec for aether.nvim, the colour scheme Omarchy's own Neovim
    template uses, with Tetra's palette, roles and syntax colours. aether reloads
    it when the Omarchy theme changes."""
    palette = dict(
        bg=c['background'], dark_bg=c['dark_background'], darker_bg=c['darker_background'],
        lighter_bg=c['lighter_background'], fg=c['foreground'], dark_fg=c['dark_foreground'],
        light_fg=c['light_foreground'], bright_fg=c['bright_foreground'], muted=c['muted'],
        **{k: c[k] for k in ('red', 'yellow', 'orange', 'green', 'cyan', 'blue', 'magenta', 'brown',
                             'bright_red', 'bright_yellow', 'bright_green', 'bright_cyan',
                             'bright_blue', 'bright_magenta', 'accent')},
        cursor=c['bright_foreground'], foreground=c['foreground'], background=c['background'],
        selection=c['selection'], selection_foreground=c['bright_foreground'],
        selection_background=c['selection'])
    colors = ''.join(f'\t\t\t\t{k} = "{h}",\n' for k, h in palette.items())
    role_lines = ''.join(f'\t{k} = "{h}",\n' for k, h in r.items())
    return (f'-- Tetra {variant.capitalize()} for Neovim: aether.nvim with Tetra\'s palette and syntax colours.\n'
            '-- Generated by ~/.config/omarchy/tetra/generate; edit that, not this file.\n'
            'local r = {\n' + role_lines + '}\n\n'
            'return {\n'
            '\t{\n'
            '\t\t"bjarneo/aether.nvim",\n'
            '\t\tbranch = "v3",\n'
            '\t\tname = "aether",\n'
            '\t\tpriority = 1000,\n'
            '\t\topts = {\n'
            '\t\t\tcolors = {\n' + colors + '\t\t\t},\n'
            '\t\t\tstyles = { comments = { italic = true }, keywords = {}, functions = {}, variables = {} },\n'
            '\t\t\ton_colors = function(c)\n'
            '\t\t\t\tlocal blend = require("aether.utils").blend_bg\n'
            '\t\t\t\tc.git = { add = r.vcs_added, delete = r.vcs_removed, change = r.vcs_modified, ignore = c.muted }\n'
            '\t\t\t\tc.diff.add = blend(r.vcs_added, 0.25)\n'
            '\t\t\t\tc.diff.delete = blend(r.vcs_removed, 0.25)\n'
            '\t\t\t\tc.error, c.warning, c.info, c.hint, c.todo = r.error, c.orange, r.tag, c.bright_cyan, c.bright_red\n'
            '\t\t\t\t-- terminal slots 0, 7, 8 and 15 as foot and Ghostty have them\n'
            '\t\t\t\tc.terminal.black, c.terminal.white = c.bg, c.fg\n'
            '\t\t\t\tc.terminal.black_bright, c.terminal.white_bright = c.muted, c.bright_fg\n'
            '\t\t\tend,\n'
            '\t\t\ton_highlights = function(hl, c)\n'
            '\t\t\t\tfor group, spec in pairs({\n' + NEOVIM_HIGHLIGHTS.replace('\n\t\t\t\t', '\n\t\t\t\t\t').replace('\t\t\t\tComment', '\t\t\t\t\tComment', 1) +
            '\t\t\t\t}) do\n'
            '\t\t\t\t\thl[group] = spec\n'
            '\t\t\t\tend\n'
            '\t\t\tend,\n'
            '\t\t},\n'
            '\t},\n'
            '\t{\n'
            '\t\t"LazyVim/LazyVim",\n'
            '\t\topts = {\n'
            '\t\t\tcolorscheme = "aether",\n'
            '\t\t},\n'
            '\t},\n'
            '}\n')


def colors_toml(variant, mode, c):
    r = RULES
    if variant == 'dark':
        text = ("Tetra Dark is the definition Mirage and Light are placed from. Shades, orange and "
                "brown start from the base24 source scheme from tinted-theming, bright colours from "
                "the source palette with normal ones 0.07 OKLCH lightness darker. Then the shades "
                "become neutral greys at the same OKLab lightness, and the hues sit 60 degrees apart "
                f"in OKHSL from red at {r['red']}, brown after red with yellow and orange "
                f"{r['split']} degrees either side of it.")
    else:
        bg, fg = GROUNDS[variant]
        text = (f"Tetra Dark placed on a ground of OKHSL lightness {bg * 100:.1f} for the "
                f"background and {fg * 100:.1f} for the foreground. Every colour keeps Dark's OKHSL "
                "hue and saturation. Shades, muted and selection keep their position between "
                "background and foreground"
                + (", with the sunk backgrounds below the background" if mode == 'light' else "") +
                ". Bright colours, orange and brown keep Dark's lightness distance from the "
                "background" + (f", at {r['light_depth']:.0%} on a light ground" if mode == 'light' else "") +
                "; normal colours are their bright colour darkened by Dark's step, held to 4.5:1.")
    text += (f" Selection sits opposite accent's OKHSL hue, {r['sel_pct']}% of the way from "
             f"{'white' if mode == 'light' else 'black'} to accent's lightness, and muted takes "
             "selection's hue and saturation.")
    lines = [f"# Tetra {variant.capitalize()}",
             "# Generated by ~/.config/omarchy/tetra/generate; edit that, not this file.",
             "#"]
    lines += ['# ' + l for l in textwrap.wrap(text, 77)]
    lines += [f'mode = "{mode}"', '']
    for group in (('accent', 'selection', 'muted'),
                  ('background', 'dark_background', 'darker_background', 'lighter_background'),
                  ('foreground', 'dark_foreground', 'light_foreground', 'bright_foreground'),
                  ('red', 'yellow', 'orange', 'green', 'cyan', 'blue', 'magenta', 'brown'),
                  ('bright_red', 'bright_yellow', 'bright_green', 'bright_cyan', 'bright_blue',
                   'bright_magenta')):
        lines += [f'{k} = "{c[k]}"' for k in group] + ['']
    return '\n'.join(lines).rstrip() + '\n'


def ghostty_theme(variant, c):
    # Same mapping as Omarchy's ghostty.conf.tpl (selection foreground and
    # cursor default to bright_foreground there), plus 16-21 like the foot
    # template in ~/.config/omarchy/themed/, including its 22: lighter_background
    # mixed 3% toward the foreground (rounded like Omarchy's mix_color).
    ansi = ['background', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'foreground',
            'muted', 'bright_red', 'bright_green', 'bright_yellow', 'bright_blue',
            'bright_magenta', 'bright_cyan', 'bright_foreground',
            'orange', 'brown', 'lighter_background', 'selection', 'dark_foreground',
            'light_foreground']
    lines = [f"# Tetra {variant.capitalize()}",
             "# Generated by ~/.config/omarchy/tetra/generate; edit that, not this file.",
             "# Palette 0-15 ANSI, 16-21 extra shades (orange, brown, lighter background,",
             "# selection, dark foreground, light foreground, status bar) used by",
             "# ~/.tmux.conf.",
             '',
             f"background = {c['background']}",
             f"foreground = {c['foreground']}",
             f"cursor-color = {c['bright_foreground']}",
             f"selection-background = {c['selection']}",
             f"selection-foreground = {c['bright_foreground']}",
             '']
    lines += [f'palette = {i}={c[k]}' for i, k in enumerate(ansi)]
    status = '#%02x%02x%02x' % tuple(int(x * 0.97 + y * 0.03 + 0.5) for x, y in
                                     zip(rgb(c['lighter_background']), rgb(c['foreground'])))
    lines.append(f'palette = 22={status}')
    return '\n'.join(lines) + '\n'


def paseo_colors(mode, c):
    # Paseo expands these into its surface ladder: raised, control, border and
    # ring become surface1-4, and ring doubles as the faintest text. control
    # and border sit between raised and ring where Paseo's built-in dark themes
    # put surface2 and surface3 (0.17 and 0.62 of the way in OKLCH lightness).
    # Buttons draw the background colour on the accent, so Light's accent and
    # muted text are darkened to the same contrast floor as its normal colours.
    def floor(h):
        while mode == 'light' and contrast(h, c['background']) < 4.5:
            h = lighten(h, -0.005)
        return h

    raised, ring = c['lighter_background'], c['muted']
    return dict(
        background=c['background'],
        foreground=c['foreground'],
        raised=raised,
        control=mix_oklab(raised, ring, 0.17),
        border=mix_oklab(raised, ring, 0.62),
        accent=floor(c['accent']),
        mutedForeground=floor(mix_oklab(c['foreground'], ring, 0.5)),
        ring=ring,
    )


def paseo_plugin():
    themes = []
    for variant in VARIANTS:
        c, mode = theme_palette(variant)
        colors = paseo_colors(mode, c)
        body = ''.join(f'      {k}: "{h}",\n' for k, h in colors.items())
        themes.append(f'  client.addTheme({{\n'
                      f'    id: "{variant}",\n'
                      f'    name: "Tetra {variant.capitalize()}",\n'
                      f'    appearance: "{mode}",\n'
                      f'    colors: {{\n{body}    }},\n'
                      f'  }});\n')
    return ('// Generated by ~/.config/omarchy/tetra/generate; edit that, not this file.\n'
            'import type { PluginClientContext } from "@getpaseo/plugin/client";\n\n'
            'export default function contribute(client: PluginClientContext) {\n'
            + ''.join(themes) +
            '  return () => {};\n'
            '}\n')


PASEO_MANIFEST = '{\n  "id": "tetra",\n  "requirements": {\n    "paseo": ">=0.12.0"\n  }\n}\n'


def write_wallpaper(theme_dir, mode, c):
    backgrounds = os.path.join(theme_dir, 'backgrounds')
    if os.path.isdir(backgrounds) and os.listdir(backgrounds):
        return
    os.makedirs(backgrounds, exist_ok=True)
    if mode == 'light':
        center, edge = '#ffffff', c['dark_background']
    else:
        center, edge = lighten(c['background'], 0.06), c['background']
    subprocess.run(['magick', '-size', '3840x2160', f'radial-gradient:{center}-{edge}',
                    '-depth', '8', '-quality', '92',
                    os.path.join(backgrounds, '1-gradient.jpg')], check=True)


def main(args):
    variants = args or list(VARIANTS)
    for variant in variants:
        if variant not in VARIANTS:
            sys.exit(f'unknown variant {variant!r} (choose from {", ".join(VARIANTS)})')

    generated = []
    for variant in variants:
        c, mode = theme_palette(variant)
        name = f'tetra-{variant}'
        theme_dir = os.path.join(THEMES_DIR, name)
        os.makedirs(theme_dir, exist_ok=True)
        with open(os.path.join(theme_dir, 'colors.toml'), 'w') as f:
            f.write(colors_toml(variant, mode, c))
        with open(os.path.join(theme_dir, 'neovim.lua'), 'w') as f:
            f.write(neovim_lua(variant, c, roles(c)))
        with open(os.path.join(theme_dir, 'icons.theme'), 'w') as f:
            f.write(ICONS)
        write_wallpaper(theme_dir, mode, c)
        os.makedirs(GHOSTTY_THEMES_DIR, exist_ok=True)
        with open(os.path.join(GHOSTTY_THEMES_DIR, name), 'w') as f:
            f.write(ghostty_theme(variant, c))
        generated.append(name)
        print(f'{name}: foreground {contrast(c["foreground"], c["background"]):.1f}:1, '
              f'lowest normal colour '
              f'{min(contrast(c[k], c["background"]) for k in HUES):.1f}:1')

    os.makedirs(PASEO_PLUGIN_DIR, exist_ok=True)
    with open(os.path.join(PASEO_PLUGIN_DIR, 'paseo-plugin.json'), 'w') as f:
        f.write(PASEO_MANIFEST)
    with open(os.path.join(PASEO_PLUGIN_DIR, 'index.client.ts'), 'w') as f:
        f.write(paseo_plugin())

    try:
        active = open(THEME_NAME_FILE).read().strip()
    except OSError:
        active = None
    if active in generated:
        print(f're-applying active theme {active}')
        subprocess.run(['omarchy-theme-refresh'], check=False)


if __name__ == '__main__':
    main(sys.argv[1:])
