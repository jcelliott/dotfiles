# --- colour maths (OKLab/OKLCH) ---------------------------------------------

def _s2l(c):
    c /= 255
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _l2s(c):
    c = max(0.0, min(1.0, c))
    v = 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055
    return round(max(0.0, min(1.0, v)) * 255)


def rgb(h):
    h = h.lstrip('#')
    return [int(h[i:i + 2], 16) for i in (0, 2, 4)]


def oklab(h):
    r, g, b = [_s2l(x) for x in rgb(h)]
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def lab_to_linear(L, a, b):
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def from_oklab(L, a, b):
    return '#%02x%02x%02x' % tuple(_l2s(x) for x in lab_to_linear(L, a, b))


def lighten(h, d):
    """Change OKLCH lightness by d."""
    L, a, b = oklab(h)
    return from_oklab(L + d, a, b)


def tint(h, t=TINT):
    """Scale OKLCH chroma by t, keeping lightness."""
    L, a, b = oklab(h)
    return from_oklab(L, a * t, b * t)


def over(fg, alpha, bg):
    """Alpha-blend fg over bg in sRGB, as editors do."""
    return '#%02x%02x%02x' % tuple(round(f * alpha + b * (1 - alpha)) for f, b in zip(rgb(fg), rgb(bg)))


def mix(a, b, t):
    return '#%02x%02x%02x' % tuple(round(x * (1 - t) + y * t) for x, y in zip(rgb(a), rgb(b)))


def mix_oklab(a, b, t):
    return from_oklab(*(x * (1 - t) + y * t for x, y in zip(oklab(a), oklab(b))))


def contrast(a, b):
    def lum(h):
        r, g, bl = [_s2l(x) for x in rgb(h)]
        return 0.2126 * r + 0.7152 * g + 0.0722 * bl
    x, y = sorted([lum(a), lum(b)])
    return (y + 0.05) / (x + 0.05)


# --- theme ------------------------------------------------------------------

def palette(v):
    b = v['base24']
    if v['mode'] == 'light':
        dark_bg = v['sunk']
        darker_bg = mix(v['sunk'], b['b05'], 0.08)
    else:
        # keep darker_background the darkest (base24 Mirage has them swapped)
        dark_bg, darker_bg = sorted([b['b10'], b['b11']], key=lambda h: -oklab(h)[0])
    sel = v['selection'] if isinstance(v['selection'], str) else over(*v['selection'])
    bg = tint(b['b00'])

    c = dict(
        accent=v['accent'],
        selection=tint(sel),
        muted=tint(v['gray']),
        background=bg,
        dark_background=tint(dark_bg),
        darker_background=tint(darker_bg),
        lighter_background=tint(b['b01']),
        foreground=tint(b['b05']),
        dark_foreground=tint(b['b04']),
        light_foreground=tint(b['b06']),
        bright_foreground=tint(b['b07']),
        orange=b['b09'],
        brown=b['b0F'],
    )
    for name, hue in v['hues'].items():
        d = v['normal_offsets'].get(name, v['normal_offset'])
        normal = lighten(hue, d)
        if v.get('normal_min_contrast'):
            while contrast(normal, bg) < v['normal_min_contrast']:
                d -= 0.005
                normal = lighten(hue, d)
        c[name] = normal
        c['bright_' + name] = lighten(hue, v['bright_offsets'][name]) if name in v['bright_offsets'] else hue
    return c


# --- OKHSL and editor roles -------------------------------------------------
#
# OKHSL (Björn Ottosson, "Okhsv and Okhsl", 2021) is OKLab with lightness put
# through a toe so it tracks CIE L*, and saturation scaled so 1 is the sRGB edge
# at every hue and lightness. Its hue is OKLCH's. Ported from his reference
# code; the showcase page uses the same port.

def _max_saturation(a, b):
    if -1.88170328 * a - 0.80936493 * b > 1:
        k0, k1, k2, k3, k4 = 1.19086277, 1.76576728, 0.59662641, 0.75515197, 0.56771245
        wl, wm, ws = 4.0767416621, -3.3077115913, 0.2309699292
    elif 1.81444104 * a - 1.19445276 * b > 1:
        k0, k1, k2, k3, k4 = 0.73956515, -0.45954404, 0.08285427, 0.12541070, 0.14503204
        wl, wm, ws = -1.2684380046, 2.6097574011, -0.3413193965
    else:
        k0, k1, k2, k3, k4 = 1.35733652, -0.00915799, -1.15130210, -0.50559606, 0.00692167
        wl, wm, ws = -0.0041960863, -0.7034186147, 1.7076147010
    S = k0 + k1 * a + k2 * b + k3 * a * a + k4 * a * b
    kl = 0.3963377774 * a + 0.2158037573 * b
    km = -0.1055613458 * a - 0.0638541728 * b
    ks = -0.0894841775 * a - 1.2914855480 * b
    l_, m_, s_ = 1 + S * kl, 1 + S * km, 1 + S * ks
    f = wl * l_ ** 3 + wm * m_ ** 3 + ws * s_ ** 3
    f1 = wl * 3 * kl * l_ * l_ + wm * 3 * km * m_ * m_ + ws * 3 * ks * s_ * s_
    f2 = wl * 6 * kl * kl * l_ + wm * 6 * km * km * m_ + ws * 6 * ks * ks * s_
    return S - f * f1 / (f1 * f1 - 0.5 * f * f2)   # one Halley step


def _find_cusp(a, b):
    S = _max_saturation(a, b)
    L = (1 / max(lab_to_linear(1, S * a, S * b))) ** (1 / 3)
    return L, L * S


def _gamut_intersection(a, b, L1, C1, L0, cusp):
    if (L1 - L0) * cusp[1] - (cusp[0] - L0) * C1 <= 0:
        return cusp[1] * L0 / (C1 * cusp[0] + cusp[1] * (L0 - L1))
    t = cusp[1] * (L0 - 1) / (C1 * (cusp[0] - 1) + cusp[1] * (L0 - L1))
    dL, dC = L1 - L0, C1
    kl = 0.3963377774 * a + 0.2158037573 * b
    km = -0.1055613458 * a - 0.0638541728 * b
    ks = -0.0894841775 * a - 1.2914855480 * b
    ldt, mdt, sdt = dL + dC * kl, dL + dC * km, dL + dC * ks
    L, C = L0 * (1 - t) + t * L1, t * C1
    l_, m_, s_ = L + C * kl, L + C * km, L + C * ks
    l, m, s = l_ ** 3, m_ ** 3, s_ ** 3
    l1, m1, s1 = 3 * ldt * l_ * l_, 3 * mdt * m_ * m_, 3 * sdt * s_ * s_
    l2, m2, s2 = 6 * ldt * ldt * l_, 6 * mdt * mdt * m_, 6 * sdt * sdt * s_

    def step(w0, w1, w2):
        r = w0 * l + w1 * m + w2 * s - 1
        r1, r2 = w0 * l1 + w1 * m1 + w2 * s1, w0 * l2 + w1 * m2 + w2 * s2
        u = r1 / (r1 * r1 - 0.5 * r * r2)
        return -r * u if u >= 0 else float('inf')
    return t + min(step(4.0767416621, -3.3077115913, 0.2309699292),
                   step(-1.2684380046, 2.6097574011, -0.3413193965),
                   step(-0.0041960863, -0.7034186147, 1.7076147010))


def _ok_cs(L, a, b):
    cusp = _find_cusp(a, b)
    c_max = _gamut_intersection(a, b, L, 1, L, cusp)
    st_max = (cusp[1] / cusp[0], cusp[1] / (1 - cusp[0]))
    s_mid = 0.11516993 + 1 / (7.44778970 + 4.15901240 * b + a * (-2.19557347 + 1.75198401 * b + a * (
        -2.13704948 - 10.02301043 * b + a * (-4.24894561 + 5.38770819 * b + 4.69891013 * a))))
    t_mid = 0.11239642 + 1 / (1.61320320 - 0.68124379 * b + a * (0.40370612 + 0.90148123 * b + a * (
        -0.27087943 + 0.61223990 * b + a * (0.00299215 - 0.45399568 * b - 0.14661872 * a))))
    k = c_max / min(L * st_max[0], (1 - L) * st_max[1])
    c_mid = 0.9 * k * (1 / (1 / (L * s_mid) ** 4 + 1 / ((1 - L) * t_mid) ** 4)) ** 0.25
    c_0 = (1 / (1 / (L * 0.4) ** 2 + 1 / ((1 - L) * 0.8) ** 2)) ** 0.5
    return c_0, c_mid, c_max


_TK1, _TK2 = 0.206, 0.03
_TK3 = (1 + _TK1) / (1 + _TK2)


def _toe(x):
    return 0.5 * (_TK3 * x - _TK1 + ((_TK3 * x - _TK1) ** 2 + 4 * _TK2 * _TK3 * x) ** 0.5)


def _toe_inv(x):
    return (x * x + _TK1 * x) / (_TK3 * (x + _TK2))


def to_okhsl(h):
    """(lightness, saturation, hue in degrees or None for a grey)."""
    L, a, b = oklab(h)
    C = math.hypot(a, b)
    if C < 2e-4 or L <= 0 or L >= 1:
        return _toe(L), 0.0, None
    c_0, c_mid, c_max = _ok_cs(L, a / C, b / C)
    if C < c_mid:
        k1 = 0.8 * c_0
        s = 0.8 * C / (k1 + (1 - k1 / c_mid) * C)
    else:
        k1 = 0.2 * c_mid * c_mid * 1.5625 / c_0
        s = 0.8 + 0.2 * (C - c_mid) / (k1 + (1 - k1 / (c_max - c_mid)) * (C - c_mid))
    return _toe(L), s, math.degrees(math.atan2(b, a)) % 360


def from_okhsl(l, s, h):
    if l >= 1:
        return '#ffffff'
    if l <= 0:
        return '#000000'
    a, b, L = math.cos(math.radians(h)), math.sin(math.radians(h)), _toe_inv(l)
    c_0, c_mid, c_max = _ok_cs(L, a, b)
    if s < 0.8:
        t, k1 = 1.25 * s, 0.8 * c_0
        C = t * k1 / (1 - (1 - k1 / c_mid) * t)
    else:
        t, k1 = (s - 0.8) / 0.2, 0.2 * c_mid * c_mid * 1.5625 / c_0
        C = c_mid + t * k1 / (1 - (1 - k1 / (c_max - c_mid)) * t)
    return from_oklab(L, C * a, C * b)


# Editor roles beyond the palette, each an OKHSL offset (lightness, saturation,
# hue in degrees) from the palette colour it sits beside, so it follows that
# colour. Most keep the offset measured between the source editor theme's role
# colour and the colour it pairs with; ROLE_OFFSETS are Tetra's own and apply
# to every variant. An optional fourth number scales saturation before the
# offset is added: special is accent at half its saturation.
ROLE_BASE = dict(tag='bright_blue', special='accent', operator='orange', error='bright_red',
                 vcs_added='bright_green', vcs_modified='bright_magenta', vcs_removed='bright_red')
# Every variant's roles are measured from Dark's.
SOURCE_ROLES = dict(   # role: (role colour, the colour it was measured against)
    tag=('#39bae6', '#59c2ff'), vcs_added=('#7fd962', '#aad94c'))
ROLE_OFFSETS = dict(special=(0, 0, 0, 0.5), operator=(-0.0035, -0.27, -9.63), error=(-0.0852, 0.0582, 7.8),
                    vcs_removed=(-0.0022, 0.1631, 2.87), vcs_modified=(-0.0283, -0.1524, -12.32))


def okhsl_offset(h, base):
    (l1, s1, h1), (l0, s0, h0) = to_okhsl(h), to_okhsl(base)
    return l1 - l0, s1 - s0, 0.0 if h1 is None or h0 is None else (h1 - h0 + 540) % 360 - 180


def apply_offset(base, offset):
    l, s, h = to_okhsl(base)
    dl, ds, dh, ks = (*offset, 1)[:4]
    return from_okhsl(min(1, max(0, l + dl)), min(1, max(0, s * ks + ds)), ((h or 0) + dh) % 360)


def roles(c):
    return {role: apply_offset(c[base], ROLE_OFFSETS.get(role) or okhsl_offset(*SOURCE_ROLES[role]))
            for role, base in ROLE_BASE.items()}


# --- Tetra as a system ------------------------------------------------------
#
# Dark's palette() after Tetra's rules is the definition. Each variant is a
# ground, the OKHSL lightness of its background and foreground (Dark keeps its
# own), and Dark's accent. The showcase page implements the same rules.
#
# The rules: neutral shades become the grey at their OKLab lightness. The hues
# sit 60 degrees apart in OKHSL from red, with brown in the slot after red and
# yellow and orange split either side of it, each keeping its OKHSL lightness
# and saturation. Selection sits opposite accent's OKHSL hue at its own
# saturation, its lightness sel_pct of the way from black to accent's (from
# white on a light ground). Muted takes selection's hue and saturation.
#
# Placing on a ground keeps every colour's OKHSL hue and saturation. Neutrals,
# muted and selection keep their position between background and foreground,
# except that a light ground puts the two sunk backgrounds below the background,
# as Omarchy's light themes do. The bright colours, orange and brown keep Dark's
# lightness distance from the background, times light_depth on a light ground,
# so the foreground never moves them. Normal colours are their bright colour
# plus Dark's step from bright to normal, held to 4.5:1 on the background.
RULES = dict(red=12, split=20, sel_pct=30, light_depth=0.6)
GROUNDS = dict(mirage=(0.135, 0.833), light=(0.968, 0.255))
HUES = ('red', 'yellow', 'green', 'cyan', 'blue', 'magenta')
NEUTRAL_KEYS = ('background', 'dark_background', 'darker_background', 'lighter_background',
                'foreground', 'dark_foreground', 'light_foreground', 'bright_foreground')
HUE_SLOTS = dict(red=0, bright_red=0, brown=1, yellow=1, bright_yellow=1, orange=1, green=2, bright_green=2,
                 cyan=3, bright_cyan=3, blue=4, bright_blue=4, magenta=5, bright_magenta=5)
SPLIT_SIGN = dict(yellow=1, bright_yellow=1, orange=-1)   # toward green, toward red


def okhsl(h):
    l, s, hue = to_okhsl(h)
    return l, s, hue or 0.0


def apply_rules(c, mode, palette_rules=True):
    """The rules on a palette; palette_rules=False applies only selection and muted."""
    c = dict(c)
    if palette_rules:
        for k in NEUTRAL_KEYS:
            c[k] = from_oklab(oklab(c[k])[0], 0, 0)
        for k, slot in HUE_SLOTS.items():
            l, s, _ = to_okhsl(c[k])
            c[k] = from_okhsl(l, s, (RULES['red'] + 60 * slot + SPLIT_SIGN.get(k, 0) * RULES['split']) % 360)
    al, _, ah = okhsl(c['accent'])
    p = RULES['sel_pct'] / 100
    c['selection'] = from_okhsl(1 - p * (1 - al) if mode == 'light' else p * al,
                                to_okhsl(c['selection'])[1], (ah + 180) % 360)
    _, s, h = okhsl(c['selection'])
    c['muted'] = from_okhsl(to_okhsl(c['muted'])[0], s, h)
    return c


def place_on_ground(src, ground, accent):
    clamp = lambda x: min(1, max(0, x))
    sbg, sfg = to_okhsl(src['background'])[0], to_okhsl(src['foreground'])[0]
    bg, fg = ground
    light = bg > fg
    away = 1 if fg > bg else -1
    out = dict(src, accent=accent)
    for k in NEUTRAL_KEYS + ('muted', 'selection'):
        l, s, h = okhsl(src[k])
        t = (l - sbg) / (sfg - sbg)
        if light and k in ('dark_background', 'darker_background'):
            t = abs(t)
        out[k] = from_okhsl(clamp(bg + t * (fg - bg)), s, h)
    depth = RULES['light_depth'] if light else 1
    for k in ('orange', 'brown') + tuple('bright_' + h for h in HUES):
        l, s, h = okhsl(src[k])
        out[k] = from_okhsl(clamp(bg + away * depth * abs(l - sbg)), s, h)
    for k in HUES:
        l, s, h = okhsl(src[k])
        nl = to_okhsl(out['bright_' + k])[0] + l - to_okhsl(src['bright_' + k])[0]
        normal = from_okhsl(clamp(nl), s, h)
        for _ in range(200):
            if contrast(normal, out['background']) >= 4.5:
                break
            nl += away * 0.005
            normal = from_okhsl(clamp(nl), s, h)
        out[k] = normal
    return out


def theme_palette(variant):
    """A variant's palette and mode (light when its background is the lighter)."""
    src = apply_rules(palette(VARIANTS['dark']), 'dark')
    ground = GROUNDS.get(variant) or (to_okhsl(src['background'])[0], to_okhsl(src['foreground'])[0])
    mode = 'light' if ground[0] > ground[1] else 'dark'
    return apply_rules(place_on_ground(src, ground, src['accent']), mode, palette_rules=False), mode


