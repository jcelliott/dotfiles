#!/bin/bash

# Push the extra shades (colour16-22, see ~/.config/omarchy/themed/foot.ini.tpl)
# to running foot terminals, like omarchy-theme-set-foot does for colour0-15.
# New terminals get them from the generated foot.ini, which this reads so the
# values match the template's (including its mixes).

foot_ini=$HOME/.local/state/omarchy/current/theme/foot.ini

if [[ ! -f $foot_ini ]] || ! pgrep -x foot >/dev/null; then
  exit 0
fi

osc=""
while IFS== read -r slot value; do
  [[ $value =~ ^[0-9A-Fa-f]{6}$ ]] && osc+=$(printf '\033]4;%d;#%s\007' "$slot" "$value")
done < <(grep -E '^(1[6-9]|2[0-2])=' "$foot_ini")
[[ -n $osc ]] || exit 0

for foot_pid in $(pgrep -x foot); do
  for child_pid in $(pgrep -P "$foot_pid"); do
    tty=$(readlink "/proc/$child_pid/fd/1" 2>/dev/null)
    [[ $tty == /dev/pts/* ]] && printf '%s' "$osc" >"$tty"
  done
done
